# Caché larga para las fuentes (Apache/LiteSpeed). Si se reemplaza un archivo,
# cambiarle el nombre para que los navegadores no sigan usando la versión anterior.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
